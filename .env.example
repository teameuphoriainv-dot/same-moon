# The SpacetimeDB database. Pick a name nobody can guess: the tables are public,
# so the name is what keeps strangers out.
NEXT_PUBLIC_STDB_MODULE=same-moon-dev
# Leave unset for Maincloud. For a local server:
NEXT_PUBLIC_STDB_HOST=ws://127.0.0.1:3055

# The one word both of you type to get in. Checked on the server, never sent to the app.
SAME_MOON_DOOR=

# Vercel Blob, for storybook photos (Plus).
BLOB_READ_WRITE_TOKEN=

# RevenueCat public API key. A Test Store key for development, the App Store key in production.
NEXT_PUBLIC_RC_API_KEY=

# Optional: a TURN relay for strict networks. Calls use Google STUN without it.
# NEXT_PUBLIC_TURN_URL=
# NEXT_PUBLIC_TURN_USER=
# NEXT_PUBLIC_TURN_PASS=

# Optional: dress the site up for a birthday.
# NEXT_PUBLIC_BIRTHDAY=09-20
# NEXT_PUBLIC_BIRTHDAY_NAME=
# NEXT_PUBLIC_BIRTHDAY_FROM=
